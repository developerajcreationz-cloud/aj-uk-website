# Copy to .env.local for local development. Set the same names in Hostinger's environment variables for production.
# Never commit real values.

# Contact form (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=grow@ajcreationz.co
SMTP_PASS=
CONTACT_TO=
# Optional: comma-separated extra origins allowed to post the form (for example a Hostinger preview URL).
CONTACT_ALLOWED_ORIGINS=
# Optional: number of proxies in front of the app. When set, the throttle uses the client IP that many entries
# from the right of X-Forwarded-For (a forged left-hand entry is then ignored). Check the host's behaviour first.
TRUSTED_PROXY_HOPS=

# Google Search Console HTML-tag token. Optional: a default is built into src/config/site.ts.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is off until this is set.
NEXT_PUBLIC_GA_ID=
